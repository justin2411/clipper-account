<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd-Job: täglich 21:30 (lokale Zeit) Vyro-Einreichung. Installieren mit scripts/install_vyro_launchd.sh
     ERST nach erfolgreichem Dry-Run (python scripts/vyro_submit.py mit Option dry-run). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.clipforge.vyro-submit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/.clipforge/env"; set +a; cd "__REPO__" &amp;&amp; "__PYTHON__" scripts/vyro_submit.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/.clipforge/vyro-submit.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.clipforge/vyro-submit.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
