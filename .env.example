# Lokale Kopie als .env (gitignored). Werte aus SECRETS.local.md. Laden: set -a; source .env; set +a
# Cloudflare (Deploy/Bootstrap; auch als GitHub-Secrets für deploy.yml)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Worker-API (Pipeline, Scripts; auch GitHub-Secrets für clip.yml)
CLIPFORGE_API_URL=https://clipforge.<subdomain>.workers.dev
CLIPFORGE_API_KEY=
# Blotato (Worker-Secret)
BLOTATO_API_KEY=
# Telegram (Worker-Secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Gmail (Worker-Secrets; OAuth refresh token, siehe scripts/gmail_auth.py)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# GitHub (Worker-Secret; fine-grained PAT, Repo justin2411/clipper-account, Actions: Read and write → workflow_dispatch)
GITHUB_TOKEN=
# KI (GitHub-Secret für clip.yml)
GOOGLE_API_KEY=            # Gemini (Momentwahl im Clipper)
ANTHROPIC_API_KEY=         # optional: Caption-Varianten
